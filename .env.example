# ---- Server ----
BACKEND_PORT=4000
NODE_ENV=development

# ---- Database ----
# Percorso del file SQLite (relativo alla root del progetto o assoluto)
DATABASE_PATH=./data/portfolio.db

# ---- Valuta base del portafoglio ----
VALUTA_BASE=EUR

# ---- Provider dati di mercato ----
# Ordine di preferenza, separato da virgole. Il primo che risponde vince.
# Provider disponibili: yahoo, twelvedata
PROVIDER_ORDINE=yahoo,twelvedata

# Twelve Data (fallback ufficiale) - chiave gratuita su https://twelvedata.com/pricing
# Lasciare vuoto per usare solo Yahoo Finance.
TWELVEDATA_API_KEY=

# Cambi valuta: la BCE via frankfurter.app non richiede chiave ed e' sempre
# usata come fallback per i tassi di cambio.
FX_PROVIDER_ORDINE=frankfurter,yahoo,twelvedata

# ---- Cache ----
# Secondi di validita' di una quotazione in cache prima di richiederla di nuovo
QUOTAZIONE_TTL_SECONDI=900

# ---- Aggiornamento automatico ----
# Cron per l'aggiornamento quotazioni + snapshot giornaliero (vuoto = disattivato)
CRON_AGGIORNAMENTO=0 19 * * 1-5
